#include <iostream>
#include <iomanip>
#define NMAX 20
typedef long long unsigned llu;
using namespace std;
//Iterativ
llu Factorial(llu n) {
     llu i, p = 1;
     for(i=2; i<=n; i++)
        p  *= i;
        return p;

}
llu FactorialRecursiv(llu n) {
    if(n<=1)
        return 1;
    return FactorialRecursiv(n-1)*n;

}

